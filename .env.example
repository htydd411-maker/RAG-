# 复制本文件为项目根目录的 .env，填入自己的密钥；.env 已被 .gitignore 排除
# 脚本用 dotenv 从项目根目录向上查找 .env，放在仓库根即可被全部脚本读到

# 自建 One API 网关
ONEAPI_API_BASE=http://localhost:3000/v1
ONEAPI_CHAT_API_KEY=在这里填OneAPI令牌
ONEAPI_EMBEDDING_API_KEY=在这里填OneAPI令牌

# 直连 OpenAI 兼容中转（API_TYPE=openai 时才会用到）
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_CHAT_API_KEY=在这里填OpenAI_KEY
OPENAI_EMBEDDING_API_KEY=在这里填OpenAI_KEY

# LangSmith 追踪，留空即不上报
LANGCHAIN_API_KEY=
